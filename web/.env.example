# Frontend Environment Variables (.env)
# Copy this file to .env and fill in your values

# Vite dev server API proxy target
VITE_API_BASE_URL=/api

# Google OAuth2 Client ID (from Google Cloud Console)
# Required for @react-oauth/google library
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here

# Backend Environment Variables (set before running backend)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:8080/api/login/oauth2/code/google
# OAUTH2_REDIRECT_SUCCESS_URL=http://localhost:3001/oauth2/callback
# OAUTH2_REDIRECT_FAILURE_URL=http://localhost:3001/login
# JWT_SECRET=your-secret-key-at-least-32-characters-long
# DATABASE_URL=postgresql://user:password@host:port/database