<resources>
    <style name="Text.WebTitle" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:fontFamily">@font/mathilda_demo</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="Text.HeadingDisplay" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:fontFamily">@font/mathilda_demo</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">34sp</item>
    </style>

    <style name="Text.SectionTitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:fontFamily">@font/mathilda_demo</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="Text.WebSubtitle" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Text.WebHandAccent" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">@font/qualityhand_regular</item>
        <item name="android:textColor">@color/secondary</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="Widget.WebPrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">28dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.WebOutlineButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="strokeColor">@color/primary</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/primary</item>
        <item name="cornerRadius">28dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="strokeColor">@color/primary</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/primary</item>
        <item name="cornerRadius">28dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Button.Google" parent="Widget.MaterialComponents.Button">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:backgroundTint">@color/surface</item>
        <item name="cornerRadius">28dp</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="InputField.Rounded" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="android:fontFamily">sans-serif</item>
        <item name="boxStrokeColor">@color/pink_100</item>
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
    </style>

    <style name="Text.CardTitle" parent="TextAppearance.MaterialComponents.Subtitle2">
        <item name="android:fontFamily">@font/mathilda_demo</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
